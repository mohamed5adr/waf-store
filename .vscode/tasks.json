{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "تشغيل المتجر (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "Path": "C:\\Program Files\\nodejs;${env:Path}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next-dev",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|starting",
          "endsPattern": "Ready in|ready in|Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
